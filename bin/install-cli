#!/usr/bin/env bash
# Official native installers; existing installations are left alone.
set -uo pipefail
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/home/linuxbrew/.linuxbrew/bin:$PATH"
FAILED=0
WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-cli.XXXXXX") || exit 1
trap 'rm -rf "$WORK_DIR"' EXIT
native_install() {
  local command_name="$1" url="$2"
  shift 2
  if command -v "$command_name" >/dev/null 2>&1; then
    echo "   already installed: $command_name"
    return
  fi
  echo "==> Installing $command_name..."
  if curl -fsSL "$url" -o "$WORK_DIR/$command_name.sh" && bash "$WORK_DIR/$command_name.sh" "$@"; then
    if ! command -v "$command_name" >/dev/null 2>&1; then
      echo "Installer completed but $command_name is missing from PATH." >&2
      FAILED=1
    fi
  else
    echo "Installation failed: $command_name" >&2
    FAILED=1
  fi
}
# Antigravity's bootstrap takes only --dir and always ends with `agy install`,
# which appends PATH and aliases to shell profiles; ~/.zshrc is a symlink into
# this repo, so those lines would land in a tracked file. The skip flags now
# belong to `agy install` itself. So: run the bootstrap against a throwaway
# HOME, keep only the verified binary, then configure the real HOME without
# touching any shell profile.
install_agy() {
  local fake_home="$WORK_DIR/agy-home"
  if command -v agy >/dev/null 2>&1; then
    echo "   already installed: agy"
    return
  fi
  echo "==> Installing agy..."
  mkdir -p "$fake_home" "$HOME/.local/bin"
  if ! { curl -fsSL https://antigravity.google/cli/install.sh -o "$WORK_DIR/agy.sh" &&
         HOME="$fake_home" bash "$WORK_DIR/agy.sh" &&
         [ -x "$fake_home/.local/bin/agy" ] &&
         cp "$fake_home/.local/bin/agy" "$HOME/.local/bin/agy"; }; then
    echo "Installation failed: agy" >&2
    FAILED=1
  elif ! "$HOME/.local/bin/agy" install --skip-aliases --skip-path; then
    # Take the binary away again: otherwise the next run would find agy,
    # report "already installed" and never finish its setup.
    rm -f "$HOME/.local/bin/agy"
    echo "Installation failed: agy (setup step 'agy install'); re-run to retry." >&2
    FAILED=1
  elif ! command -v agy >/dev/null 2>&1; then
    echo "Installer completed but agy is missing from PATH." >&2
    FAILED=1
  fi
}
native_install claude https://claude.ai/install.sh
native_install agent https://cursor.com/install
install_agy
if command -v codex >/dev/null 2>&1; then
  echo "   already installed: codex"
elif ! command -v npm >/dev/null 2>&1; then
  echo "npm is required to install Codex CLI." >&2
  FAILED=1
elif ! npm install -g @openai/codex; then
  FAILED=1
fi
exit "$FAILED"
