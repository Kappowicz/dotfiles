# Machine-local git configuration -> ~/.gitconfig. Never tracked.
#
# `git config --global ...` writes HERE. The shared settings are pulled in by
# the include below, so nothing any tool writes can reach the repository.
# __DOTFILES__ is replaced with the repo path by install.sh.
#
# On GitHub, prefer the noreply address so your real one stays out of public
# commit metadata: Settings -> Emails -> "Keep my email address private" gives
# you an ID+username@users.noreply.github.com address. Tick "Block command
# line pushes that expose my email" while you are there.

[include]
	path = __DOTFILES__/git/.gitconfig

[user]
	name = Your Name
	email = you@example.com
