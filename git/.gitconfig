# Shared git settings. This file is INCLUDED by ~/.gitconfig, never symlinked
# to it — see git/gitconfig.example and install.sh.
#
# The distinction matters: `git config --global ...` writes to ~/.gitconfig.
# If that path were a symlink into this repository, any tool that sets a global
# option (an IDE, a helper, another shell session) would silently modify a
# tracked file, and your name and email would ride along on the next commit.

[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[pull]
	rebase = true
[core]
	pager = delta
	excludesfile = ~/.config/git/ignore
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
[merge]
	conflictstyle = zdiff3
