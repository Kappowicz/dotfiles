<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.dotfiles.cleanup</string>

  <!-- Weekly disk cleanup. Fires daily, but the script itself only does the real work
       once a week, and only on mains power or a battery above 65%, so a laptop
       that was asleep or nearly flat at this hour loses a day rather than the
       whole week.
       __HOME__ is substituted by install.sh. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>12</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/mac-cleanup</string>
  </array>

  <key>RunAtLoad</key>          <false/>
  <key>ProcessType</key>        <string>Background</string>
  <key>LowPriorityIO</key>      <true/>
  <key>Nice</key>               <integer>10</integer>
  <key>StandardOutPath</key>    <string>__HOME__/Library/Logs/dotfiles/cleanup.log</string>
  <key>StandardErrorPath</key>  <string>__HOME__/Library/Logs/dotfiles/cleanup.log</string>
</dict>
</plist>
